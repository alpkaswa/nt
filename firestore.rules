rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isUserEmail(email) {
      return isSignedIn() && request.auth.token.email.lower() == email.lower();
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        isUserEmail('dtc245160052@ictu.edu.vn')
      );
    }

    // Admins registry
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == userId && isUserEmail('dtc245160052@ictu.edu.vn'));
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
      );
      allow delete: if isAdmin();
    }

    // Employees collection
    match /employees/{employeeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Shifts collection
    match /shifts/{shiftId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Shift change requests
    match /shift_change_requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Shift change history (Immutable audit log)
    match /shift_change_history/{historyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Unavailable dates (Leave requests)
    match /unavailable_dates/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    // Compensatory duties
    match /compensatory_duties/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Schedule settings
    match /schedule_settings/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
